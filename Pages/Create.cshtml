@page
@model Post
@{
    ViewData["Title"] = "Create a Post";
}

<form action="Create/CreatePost" method="post">

	<div>
		<label asp-for="Title"></label>
		<input asp-for="Title" />
	</div>

	<div>
		<label asp-for="Body"></label>
		<input asp-for="Body" type="textarea" />
	</div>

	<button type="submit">Post</button>
</form>

